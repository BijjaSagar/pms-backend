# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL. This is the TriponX database.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# ---------------------------------------------------------------------------
# Optional overrides. Every one has a working default, so a fresh checkout runs
# with none of these set.
# ---------------------------------------------------------------------------

# Where the frontend is served from. The CSRF check compares unsafe requests
# against this origin, so it must match where the app actually runs.
# Comma-separate to allow several origins.
FRONTEND_URL="http://localhost:5173"

# Session lifetime in hours. Sessions are revoked server-side on logout and on
# account deactivation, so shortening this is safe.
SESSION_TTL_HOURS=12

# Set to "false" to disable the cross-site request check. Do not do this outside
# local development: the session cookie's SameSite=Lax is the primary defence
# and this is the second.
# CSRF_PROTECTION=true

# ---------------------------------------------------------------------------
# Rate limiting
#
# The defaults are the production values. The verification suites authenticate
# as five roles plus every account each phase creates, which overruns a ceiling
# of 10 and reports failures that have nothing to do with the code under test.
# To run the suites back to back, raise both in your local `.env` only:
#
#   LOGIN_RATE_LIMIT_PER_MINUTE=100
#   RATE_LIMIT_PER_MINUTE=2000
#
# Leave them unset when running the Phase 10 security suite — it proves the
# throttle works, and it can only do that against the real ceiling.
# ---------------------------------------------------------------------------

# LOGIN_RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_MINUTE=120