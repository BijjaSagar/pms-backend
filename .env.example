# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL. This is the TriponX database.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# ---------------------------------------------------------------------------
# Optional overrides. Every one has a working default, so a fresh checkout runs
# with none of these set.
# ---------------------------------------------------------------------------

# Where the frontend is served from. The CSRF check compares unsafe requests
# against this origin, so it must match where the app actually runs.
# Comma-separate to allow several origins.
FRONTEND_URL="http://localhost:5173"

# Session lifetime in hours. Sessions are revoked server-side on logout and on
# account deactivation, so shortening this is safe.
SESSION_TTL_HOURS=12

# Set to "false" to disable the cross-site request check. Do not do this outside
# local development: the session cookie's SameSite=Lax is the primary defence
# and this is the second.
# CSRF_PROTECTION=true

# ---------------------------------------------------------------------------
# Rate limiting
#
# The defaults are the production values. Raise them in your local `.env` only
# if you script many logins in a row (login is throttled to 10 attempts per
# minute per IP).
# ---------------------------------------------------------------------------

# LOGIN_RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_MINUTE=120