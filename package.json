{
  "name": "triponx-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "postinstall": "prisma skills sync || exit 0",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:verify": "prisma db verify",
    "db:migrate": "prisma db migrate",
    "db:seed": "tsx prisma/seed.ts",
    "db:dev-users": "tsx prisma/dev-users.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:truncate": "tsx prisma/truncate.ts",
    "db:reseed": "tsx prisma/truncate.ts && tsx prisma/seed.ts && tsx prisma/dev-users.ts && tsx prisma/seed-demo.ts",
    "db:generate": "prisma contract emit",
    "db:status": "prisma migration status",
    "db:verify:schema": "tsx prisma/verify-schema.ts",
    "db:verify:counts": "tsx prisma/verify-counts.ts",
    "db:verify:permissions": "tsx prisma/verify-permissions.ts",
    "db:verify:audit": "tsx prisma/verify-audit.ts",
    "db:verify:2a": "tsx prisma/verify-phase2a.ts",
    "db:verify:5a": "tsx prisma/verify-phase5a.ts",
    "db:verify:contract": "tsx prisma/verify-frontend-contract.ts",
    "db:verify:6": "tsx prisma/verify-phase6.ts",
    "db:verify:7": "tsx prisma/verify-phase7.ts",
    "db:verify:8": "tsx prisma/verify-phase8.ts",
    "db:verify:9": "tsx prisma/verify-phase9.ts",
    "db:verify:10-security": "tsx prisma/verify-phase10-security.ts",
    "db:verify:10-concurrency": "tsx prisma/verify-phase10-concurrency.ts",
    "db:verify:10-rbac": "tsx prisma/verify-phase10-rbac.ts",
    "db:verify:10-e2e": "tsx prisma/verify-phase10-e2e.ts",
    "db:backup": "powershell -ExecutionPolicy Bypass -File scripts/backup.ps1",
    "db:restore-drill": "powershell -ExecutionPolicy Bypass -File scripts/restore-drill.ps1",
    "db:verify:3": "tsx prisma/verify-phase3.ts",
    "db:verify:4a": "tsx prisma/verify-phase4a.ts",
    "db:reset": "tsx prisma/drop-schema.ts && prisma db migrate && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^7.10.0",
    "@prisma/orm-postgres": "^8.0.0-rc.17",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.7",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/helmet": "^0.0.48",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "8.0.0-rc.22",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
